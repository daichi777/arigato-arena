{
  "name": "arigato-arena",
  "version": "0.0.1",
  "private": true,
  "description": "社内イベント用FPS - チームデスマッチ 5v5",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "asset:audit": "node scripts/asset-audit.mjs",
    "glb:audit": "node scripts/glb-audit.mjs",
    "assets:link": "node scripts/link-assets.mjs",
    "postinstall": "node scripts/link-assets.mjs",
    "clean": "pnpm -r exec rm -rf node_modules dist .next .turbo",
    "deploy:server": "pnpm --filter @arigato/server deploy"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^22.7.5",
    "prettier": "^3.3.3",
    "eslint": "^9.12.0",
    "@typescript-eslint/parser": "^8.8.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "concurrently": "^9.0.1"
  }
}
