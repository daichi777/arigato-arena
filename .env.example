# ============================================================================
# ArigatoArena 環境変数テンプレート
# このファイルをコピーして .env.local を作成、実値を入れる
# .env.local は .gitignore でコミット除外される
# ============================================================================

# Supabase（apps/client 用）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase（apps/server 用 - PartyKit Secrets に登録）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PartyKit エンドポイント（apps/client から接続）
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999
