# ============================================================================
# apps/client 環境変数テンプレート（Vercel 環境変数 / .env.local 用）
# ============================================================================
# ローカル開発: このファイルを .env.local にコピーして値を入力
# 本番:         Vercel ダッシュボードの Environment Variables に同じキーを登録
# ============================================================================

# PartyKit 接続先ホスト（wss:// プレフィックスなし）
# - ローカル開発: 127.0.0.1:1999
# - 本番: arigato-arena.<your-account>.partykit.dev
NEXT_PUBLIC_PARTYKIT_HOST=127.0.0.1:1999

# Supabase（現状クライアントから直接 Supabase は不使用）
# 将来読み取り用に使う場合のみコメントを外す
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
