# ============================================================================
# apps/server 環境変数テンプレート（PartyKit Secrets 登録用）
# ============================================================================
# これらの値は partykit.json の "vars" には書かず、
# CLI コマンドで Secrets として登録すること（平文でコミットしない）
#
# 登録コマンド:
#   pnpm dlx partykit env add SUPABASE_URL
#   pnpm dlx partykit env add SUPABASE_SERVICE_ROLE_KEY
#
# ローカル開発時は apps/server/.env.local に記述（.gitignore 済み）
# ============================================================================

# Supabase プロジェクト URL（例: https://xxxxxxxxxxxx.supabase.co）
SUPABASE_URL=

# Supabase Service Role Key（管理者権限。絶対に外部公開しない）
SUPABASE_SERVICE_ROLE_KEY=
